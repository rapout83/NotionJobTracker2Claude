# n8n Environment Variables Configuration

# Basic Auth for n8n web interface
# Set to 'true' to enable username/password login
N8N_BASIC_AUTH_ACTIVE=false
N8N_USER=admin
N8N_PASSWORD=changeme

# n8n Encryption Key - CRITICAL!
# Generate with: openssl rand -hex 32
# NEVER change this after initial setup or you'll lose access to all credentials!
N8N_ENCRYPTION_KEY=changeme-use-openssl-rand-hex-32-to-generate

# PostgreSQL Database Configuration
N8N_DB_NAME=n8n
N8N_DB_USER=n8nuser
N8N_DB_PASSWORD=changeme-use-strong-password

# Timezone
TZ=America/New_York

# Optional: Enable n8n runners for better performance
N8N_RUNNERS_ENABLED=true
