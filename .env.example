# Notion Configuration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
PORT=8000
HOST=0.0.0.0

# Cache Configuration (for MCP integration)
CACHE_DIR=webhook/cache
CACHE_MAX_ENTRIES=10
CACHE_TTL_HOURS=24

# Logging
LOG_LEVEL=INFO

# ============================================================================
# Optional: Claude API Configuration (DEPRECATED - Use MCP instead)
# ============================================================================
# These are no longer needed for the MCP architecture
# Only uncomment if you want to add direct Claude API features in the future
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
