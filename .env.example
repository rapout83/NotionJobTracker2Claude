# Notion Configuration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Optional: n8n Configuration (only needed if using self-hosted n8n)
# Basic Auth for n8n web interface
N8N_BASIC_AUTH_ACTIVE=false
N8N_USER=admin
N8N_PASSWORD=changeme

# n8n Encryption Key - IMPORTANT: Generate a random 32+ character string!
# Use: openssl rand -hex 32
# Keep this secret and NEVER change it after initial setup (you'll lose access to credentials)
N8N_ENCRYPTION_KEY=changeme-use-openssl-rand-hex-32-to-generate

# n8n PostgreSQL Database Configuration
N8N_DB_NAME=n8n
N8N_DB_USER=n8nuser
N8N_DB_PASSWORD=n8npass

# Timezone
TZ=America/New_York

# Optional: Enable n8n runners for better performance
N8N_RUNNERS_ENABLED=true
